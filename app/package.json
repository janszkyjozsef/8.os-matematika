  },
  "dependencies": {
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
